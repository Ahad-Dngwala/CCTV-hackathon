# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# Virtual Environments
.venv
env/
venv/
ENV/

# IDE / Editor configs
.idea/
.vscode/

# Local databases & dumps
*.sqlite3
*.dump

# Test & coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db

# Crops and runtime media (stored in model2_analytics)
model2_analytics/detection-image/*
!model2_analytics/detection-image/.gitkeep
model2_analytics/uploads/*
!model2_analytics/uploads/.gitkeep

# ── Model 2 — AI pipeline heavy/generated artifacts (03-Sep-2026) ──
weights/
model2_analytics/pipeline/dataset/
# NOTE: a single '*' doesn't cross a '/' in gitignore, so this only ever
# matched *.pt files directly inside pipeline/ - not ones in subdirectories
# like pipeline/detection/. That's exactly how indian_traffic_yolov8.pt (6MB)
# ended up committed despite this line already existing (AuditReport1.md
# finding 13 / 3.4). '**/' matches any depth, including zero, so this now
# also still covers the pipeline/*.pt case the line used to hit.
model2_analytics/pipeline/**/*.pt
model2_analytics/pipeline/*.cache
model2_analytics/pipeline/dataset.yaml
demo_results/

# ── Model 2 — OCR Fine-Tuning Experiments ──
model2_analytics/experiments/


